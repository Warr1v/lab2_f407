diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9f02cf2..c591986 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -53,6 +53,11 @@ target_sources(${CMAKE_PROJECT_NAME} PRIVATE
     App/Screen/screen_selftest.c
     App/Mock/screen_mock.c
     App/Game/snake.c
+    App/Wave/wave.c
+    App/Wave/wave_hw.c
+    App/Wave/wave_math.c
+    App/Wave/spwm.c
+    App/Wave/wave_diagnostics.c
 )
 
 # Add include paths
@@ -62,6 +67,8 @@ target_include_directories(${CMAKE_PROJECT_NAME} PRIVATE
     App/Screen
     App/Mock
     App/Game
+    App/Contracts
+    App/Wave
 )
 
 # Add project symbols (macros)
@@ -69,6 +76,19 @@ target_compile_definitions(${CMAKE_PROJECT_NAME} PRIVATE
     # Add user defined symbols
 )
 
+option(WAVE_ENABLE_DIAGNOSTICS "Enable explicit debugger Wave test commands" OFF)
+if(WAVE_ENABLE_DIAGNOSTICS)
+    target_compile_definitions(${CMAKE_PROJECT_NAME} PRIVATE WAVE_DIAGNOSTIC_ENABLE=1)
+endif()
+
+# Keep the frozen API callable from a debugger before the real UI is integrated.
+foreach(api Wave_Init Wave_Process Wave_SetMode Wave_GetMode Wave_GetCapabilities
+    Wave_Apply Wave_SetEnabled Wave_GetSnapshot Wave_SetSync Wave_SetPhase
+    Wave_GetSyncSnapshot Wave_AcquireA Wave_ReleaseA Wave_Calculate
+    Spwm_Init Spwm_Start Spwm_Stop Spwm_GetSnapshot)
+    target_link_options(${CMAKE_PROJECT_NAME} PRIVATE "-Wl,--undefined=${api}")
+endforeach()
+
 # Remove wrong libob.a library dependency when using cpp files
 list(REMOVE_ITEM CMAKE_C_IMPLICIT_LINK_LIBRARIES ob)
 
